.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
*.egg-info/
.DS_Store

# Secrets -- never committed. .env.example is the template and IS committed.
.env
.env.local
.env.*.local

# Raw/processed data is regenerated by the pipeline from nflverse -- not committed.
# (Prediction snapshots ARE committed: they are the immutable record.)
data/raw/
data/processed/
# Phase 2B: per-season pbp cache lives under data/raw (already ignored). Odds snapshots
# and prediction snapshots ARE committed (immutable record).
!data/odds/
data/processed/baseline/
